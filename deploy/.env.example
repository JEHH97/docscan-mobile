# Public HTTPS origin serving the mobile web demo (no trailing slash).
CORS_ORIGINS=https://docscan.example.com
MAX_UPLOAD_BYTES=5242880
RATE_LIMIT_PER_MINUTE=10
RESULT_TTL_SECONDS=3600
# Leave empty for a public, unauthenticated demo. Never commit a real key.
API_KEY=
WEBHOOKS_ENABLED=false
API_URL=https://api.docscan.example.com

# Published version defaults are pinned to the release tag; override only to test another immutable tag.
DOCSCAN_API_TAG=v1.0.1
DOCSCAN_MOBILE_WEB_TAG=v1.0.1
API_BIND_ADDRESS=127.0.0.1
API_HOST_PORT=7860
WEB_BIND_ADDRESS=127.0.0.1
WEB_HOST_PORT=8080
