{
  "name": "docscan-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "verify:export": "node scripts/verify-web-export.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --coverage --runInBand",
    "scan": "node scripts/scan-forbidden.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run scan"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "5.108.1",
    "expo": "~58.0.26",
    "expo-camera": "58.0.14",
    "expo-clipboard": "58.0.4",
    "expo-image-picker": "58.0.10",
    "expo-router": "58.0.32",
    "expo-sharing": "58.0.23",
    "expo-status-bar": "58.0.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-web": "0.21.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "@types/react-test-renderer": "19.3.1",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "jest": "30.5.2",
    "jest-expo": "58.0.15",
    "prettier": "3.10.1",
    "react-test-renderer": "19.3.1",
    "typescript": "6.0.3"
  },
  "overrides": {
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  }
}
