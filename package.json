{
  "name": "docscan-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest --coverage --runInBand",
    "scan": "node scripts/scan-forbidden.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run scan"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "latest",
    "expo": "~58.0.26",
    "expo-camera": "latest",
    "expo-clipboard": "latest",
    "expo-image-picker": "latest",
    "expo-router": "latest",
    "expo-sharing": "latest",
    "expo-status-bar": "latest",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "latest",
    "react-native-safe-area-context": "latest",
    "react-native-screens": "latest",
    "react-native-web": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@babel/core": "latest",
    "@testing-library/react-native": "latest",
    "@types/jest": "latest",
    "@types/react": "latest",
    "@types/react-test-renderer": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "eslint": "latest",
    "eslint-config-expo": "latest",
    "jest": "latest",
    "jest-expo": "latest",
    "prettier": "latest",
    "react-test-renderer": "19.3.0",
    "typescript": "latest"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
